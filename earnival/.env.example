# ---- Database ----
# Pooled connection — serverless functions each open their own connection and
# Postgres caps out around 100, so a ticket drop exhausts it without a pooler.
# Neon: add ?pgbouncer=true&connect_timeout=15   Supabase: use the :6543 pooler.
DATABASE_URL="postgresql://user:pass@host:6543/earnival?pgbouncer=true&connection_limit=1"

# Unpooled — migrations only; poolers cannot run them.
DIRECT_DATABASE_URL="postgresql://user:pass@host:5432/earnival"

# ---- App ----
APP_URL="http://localhost:3000"
AUTH_SECRET=""
QR_SECRET=""

# ---- Paystack (test keys) ----
# Get these from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# ---- Email (optional; falls back to console transport in dev) ----
RESEND_API_KEY=""
EMAIL_FROM="Earnival <tickets@earnival.app>"

# ---- Identity data encryption (NDPR / VRF-07) ----
# Separate from AUTH_SECRET so a leaked session key never exposes BVN/NIN data.
KYC_SECRET=""

# ---- Scheduled jobs ----
# Bearer token protecting /api/cron/settle
CRON_SECRET=""

# ---- SMS (optional; falls back to console) ----
TERMII_API_KEY=""
TERMII_SENDER_ID="Earnival"

# ---- Vendor sale alerts (optional; falls back to SMS, then console in dev) ----
# WhatsApp Cloud API. Business-initiated messages need an approved template.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LOCALE="en"

# ---- Observability (optional but strongly recommended in production) ----
# Sentry DSN for error capture.
SENTRY_DSN=""
# Slack or Discord incoming webhook — money failures are pushed here.
ALERT_WEBHOOK_URL=""
