# ---- Database ----
DATABASE_URL="postgresql://earnival:earnival@127.0.0.1:5432/earnival?schema=public"

# ---- App ----
APP_URL="http://localhost:3000"
AUTH_SECRET=""
QR_SECRET=""

# ---- Paystack (test keys) ----
# Get these from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# ---- Email (optional; falls back to console transport in dev) ----
RESEND_API_KEY=""
EMAIL_FROM="Earnival <tickets@earnival.app>"

# ---- Identity data encryption (NDPR / VRF-07) ----
# Separate from AUTH_SECRET so a leaked session key never exposes BVN/NIN data.
KYC_SECRET=""

# ---- Scheduled jobs ----
# Bearer token protecting /api/cron/settle
CRON_SECRET=""

# ---- SMS (optional; falls back to console) ----
TERMII_API_KEY=""
TERMII_SENDER_ID="Earnival"
